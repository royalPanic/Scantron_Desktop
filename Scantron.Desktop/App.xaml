<Application x:Class="Scantron.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Views="clr-namespace:Scantron.Desktop.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <Views:BoolToVisibleConverter x:Key="BoolToVisible" />
            <Views:NullToVisibleConverter x:Key="NullToVisible" />

            <!-- Neutral, dense styling. A warehouse tool is read at arm's length under bad
                 light, so contrast is high and nothing depends on colour alone to carry
                 meaning. -->
            <SolidColorBrush x:Key="ChromeBrush" Color="#FF1E2229" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF2A2F38" />
            <SolidColorBrush x:Key="BorderBrushSoft" Color="#FF3C434F" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFEDEFF3" />
            <SolidColorBrush x:Key="TextDimBrush" Color="#FF9AA3B2" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFE0A33E" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFE05A5A" />
            <SolidColorBrush x:Key="OkBrush" Color="#FF4CAF7D" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HeadingText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="DimText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinWidth" Value="84" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Edge"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Explicit hover and disabled states: the default WPF template
                                 draws a system-chrome button that ignores the dark palette. -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Edge" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushSoft}" />
                <Setter Property="RowBackground" Value="{StaticResource ChromeBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelBrush}" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="RoundBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
