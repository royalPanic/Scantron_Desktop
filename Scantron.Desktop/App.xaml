<Application x:Class="Scantron.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Views="clr-namespace:Scantron.Desktop.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
            <ResourceDictionary>

                <!--
                  One Material dictionary, merged so every window and dialog in the app resolves the
                  same tokens. Colour roles, the type scale and the control templates all live in
                  there; this file holds only the view-layer converters, which are specific to this
                  app's bindings rather than part of the design system.
                -->
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="Themes/MaterialTheme.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <Views:BoolToVisibleConverter x:Key="BoolToVisible" />
                <Views:HasSelectionToVisibleConverter x:Key="HasSelectionToVisible" />
                <Views:EmptyToVisibleConverter x:Key="EmptyToVisible" />
            <Views:ItemPaneEmptyStateConverter x:Key="ItemPaneEmptyState" />

                <!-- Pane headings. Shared by all three columns so they stay in step. -->
                <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource Type.TitleMedium}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>

                <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Type.LabelMedium}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceVariant}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource Type.BodyMedium}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
                </Style>

                <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource Type.BodySmall}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceVariant}" />
                </Style>

                <!--
                  Empty-state block: the icon-less title and supporting line the device shows when a
                  list has no rows. The list itself collapses and this takes its place, so the pane
                  explains itself rather than presenting a blank rectangle.
                -->
                <Style x:Key="EmptyStateTitle" TargetType="TextBlock" BasedOn="{StaticResource Type.TitleSmall}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceVariant}" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>

                <Style x:Key="EmptyStateBody" TargetType="TextBlock" BasedOn="{StaticResource Type.BodyMedium}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Outline}" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="MaxWidth" Value="260" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>

                <!-- Toolbar / app-bar button group: flush layout between the button and the
                     next, since Material groups related actions without a visible container. -->
                <Style x:Key="AppBarButton" TargetType="Button" BasedOn="{StaticResource Material.TextButton}">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="36" />
                </Style>

            </ResourceDictionary>
        </Application.Resources>
    </Application>
