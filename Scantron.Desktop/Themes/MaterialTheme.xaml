<!--
  Material 3 design tokens and control templates for the desktop shell.

  The palette is the handheld's own (see Scantron/app/.../ui/theme/Color.kt): primary blue,
  secondary teal, tertiary orange. The operator moves between the CK65 and this PC all shift,
  and an operator who learned "orange means needs attention" on the device should not have to
  relearn it here.

  Neutrals are derived from the same blue rather than lifted from the M3 baseline ramp. The
  baseline is a purple placeholder that the device ships because it overrides nothing, and
  inheriting it would tint every surface lilac for no reason. Structure, roles and state-layer
  opacities follow the spec; the hue does not.

  Type sizes are the M3 scale by role, scaled up for a screen read at arm's length under bad
  light. Android's 16sp body is ~9.6 WPF units - correct in physical terms, unreadable in
  practice at 100% scaling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================ Colour roles ============================ -->

    <!-- Material Design 3 color roles - primary palette -->
    <Color x:Key="Palette.Primary">#1E88E5</Color> <!-- Blue 500 -->
    <Color x:Key="Palette.OnPrimary">#FFFFFF</Color>
    <Color x:Key="Palette.PrimaryContainer">#D3E7FB</Color>
    <Color x:Key="Palette.OnPrimaryContainer">#0A2B45</Color>

    <Color x:Key="Palette.Secondary">#00897B</Color> <!-- Teal 700 -->
    <Color x:Key="Palette.OnSecondary">#FFFFFF</Color>
    <Color x:Key="Palette.SecondaryContainer">#C9EFE9</Color>
    <Color x:Key="Palette.OnSecondaryContainer">#04231F</Color>

    <Color x:Key="Palette.Tertiary">#FB8C00</Color> <!-- Orange 500 -->
    <Color x:Key="Palette.OnTertiary">#FFFFFF</Color>
    <Color x:Key="Palette.TertiaryContainer">#FFE7C2</Color>
    <Color x:Key="Palette.OnTertiaryContainer">#3A2000</Color>

    <Color x:Key="Palette.Error">#B3261E</Color> <!-- Red 600 -->
    <Color x:Key="Palette.OnError">#FFFFFF</Color>
    <Color x:Key="Palette.ErrorContainer">#F9DEDC</Color>
    <Color x:Key="Palette.OnErrorContainer">#410E0B</Color>

    <!-- Surface roles - neutrals derived from primary blue (not MD3 purple baseline) -->
    <Color x:Key="Palette.Surface">#FBFCFE</Color> <!-- Almost white, blue-tinted -->
    <Color x:Key="Palette.OnSurface">#1A1C1E</Color> <!-- Almost black -->
    <Color x:Key="Palette.SurfaceVariant">#E1E7EF</Color> <!-- Medium contrast surface -->
    <Color x:Key="Palette.OnSurfaceVariant">#43474E</Color> <!-- On-surface variant -->
    <Color x:Key="Palette.Outline">#74797F</Color> <!-- Outline / dividers -->
    <Color x:Key="Palette.OutlineVariant">#C3C7CF</Color> <!-- Outline variant / disabled -->

    <!-- Extended surface roles per MD3 -->
    <Color x:Key="Palette.SurfaceContainerLow">#F4F7FA</Color>
    <Color x:Key="Palette.SurfaceContainer">#FFFFFF</Color>
    <Color x:Key="Palette.SurfaceContainerHigh">#E9EEF4</Color>
    <Color x:Key="Palette.SurfaceContainerHighest">#E2E7EB</Color>
    <Color x:Key="Palette.InverseSurface">#2F3133</Color>
    <Color x:Key="Palette.InverseOnSurface">#F1F0EF</Color>

    <!-- Additional MD3 color roles for completeness -->
    <Color x:Key="Palette.Shadow">#FF000000</Color>
    <Color x:Key="Palette.Scrim">#66000000</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Palette.Primary}" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Palette.OnPrimary}" />
    <SolidColorBrush x:Key="Brush.PrimaryContainer" Color="{StaticResource Palette.PrimaryContainer}" />
    <SolidColorBrush x:Key="Brush.OnPrimaryContainer" Color="{StaticResource Palette.OnPrimaryContainer}" />

    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Palette.Secondary}" />
    <SolidColorBrush x:Key="Brush.OnSecondary" Color="{StaticResource Palette.OnSecondary}" />
    <SolidColorBrush x:Key="Brush.SecondaryContainer" Color="{StaticResource Palette.SecondaryContainer}" />
    <SolidColorBrush x:Key="Brush.OnSecondaryContainer" Color="{StaticResource Palette.OnSecondaryContainer}" />

    <SolidColorBrush x:Key="Brush.Tertiary" Color="{StaticResource Palette.Tertiary}" />
    <SolidColorBrush x:Key="Brush.OnTertiary" Color="{StaticResource Palette.OnTertiary}" />
    <SolidColorBrush x:Key="Brush.TertiaryContainer" Color="{StaticResource Palette.TertiaryContainer}" />
    <SolidColorBrush x:Key="Brush.OnTertiaryContainer" Color="{StaticResource Palette.OnTertiaryContainer}" />

    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Palette.Error}" />
    <SolidColorBrush x:Key="Brush.OnError" Color="{StaticResource Palette.OnError}" />
    <SolidColorBrush x:Key="Brush.ErrorContainer" Color="{StaticResource Palette.ErrorContainer}" />
    <SolidColorBrush x:Key="Brush.OnErrorContainer" Color="{StaticResource Palette.OnErrorContainer}" />

    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Palette.Surface}" />
    <SolidColorBrush x:Key="Brush.OnSurface" Color="{StaticResource Palette.OnSurface}" />
    <SolidColorBrush x:Key="Brush.SurfaceVariant" Color="{StaticResource Palette.SurfaceVariant}" />
    <SolidColorBrush x:Key="Brush.OnSurfaceVariant" Color="{StaticResource Palette.OnSurfaceVariant}" />
    <SolidColorBrush x:Key="Brush.Outline" Color="{StaticResource Palette.Outline}" />
    <SolidColorBrush x:Key="Brush.OutlineVariant" Color="{StaticResource Palette.OutlineVariant}" />

    <SolidColorBrush x:Key="Brush.SurfaceContainerLow" Color="{StaticResource Palette.SurfaceContainerLow}" />
    <SolidColorBrush x:Key="Brush.SurfaceContainer" Color="{StaticResource Palette.SurfaceContainer}" />
    <SolidColorBrush x:Key="Brush.SurfaceContainerHigh" Color="{StaticResource Palette.SurfaceContainerHigh}" />
    <SolidColorBrush x:Key="Brush.InverseSurface" Color="{StaticResource Palette.InverseSurface}" />
    <SolidColorBrush x:Key="Brush.InverseOnSurface" Color="{StaticResource Palette.InverseOnSurface}" />

    <!--
      State layers. Material expresses hover/press as a tint of the on-* colour at 8% and 12%
      laid over the container. WPF has no state layer, so the composites are precomputed here
      rather than faked with Opacity - a translucent brush over a brush would show whatever sits
      behind it, which on a card over a page background is not the same colour at all.
    -->
    <SolidColorBrush x:Key="State.OnSurface.Hover" Color="#E9EAEC" />
    <SolidColorBrush x:Key="State.OnSurface.Pressed" Color="#E0E1E3" />
    <SolidColorBrush x:Key="State.Primary.Hover" Color="#3092E7" />
    <SolidColorBrush x:Key="State.Primary.Pressed" Color="#3996E8" />
    <SolidColorBrush x:Key="State.SecondaryContainer.Hover" Color="#B9DED9" />
    <SolidColorBrush x:Key="State.SecondaryContainer.Pressed" Color="#B1D7D1" />

    <SolidColorBrush x:Key="Brush.DisabledContainer" Color="#EAEBED" />
    <SolidColorBrush x:Key="Brush.DisabledContent" Color="#A6A7A9" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#4D000000" />

    <!-- ============================ Shape ============================ -->

    <!-- Material Design 3 shape radii -->
    <CornerRadius x:Key="Shape.ExtraSmall">2</CornerRadius>
    <CornerRadius x:Key="Shape.Small">4</CornerRadius>
    <CornerRadius x:Key="Shape.Medium">8</CornerRadius>
    <CornerRadius x:Key="Shape.Large">12</CornerRadius>
    <CornerRadius x:Key="Shape.XLarge">16</CornerRadius>
    <CornerRadius x:Key="Shape.Button">20</CornerRadius>
    <CornerRadius x:Key="Shape.Full">999</CornerRadius>
    <CornerRadius x:Key="Shape.Pill">9999</CornerRadius>

    <!-- ============================ Elevation ============================ -->

    <!-- Material Design 3 elevation levels -->
    <!-- Level 0: No elevation (flat) -->
    <DropShadowEffect x:Key="Elevation.Level0" BlurRadius="0" ShadowDepth="0" Direction="270"
                      Color="Transparent" RenderingBias="Quality" />

    <!-- Level 1: Minimal elevation - subtle shadow -->
    <DropShadowEffect x:Key="Elevation.Level1" BlurRadius="2" ShadowDepth="0" Direction="270"
                      Color="#1F000000" RenderingBias="Quality" />

    <!-- Level 2: Small elevation - card-like shadow -->
    <DropShadowEffect x:Key="Elevation.Level2" BlurRadius="4" ShadowDepth="1" Direction="270"
                      Color="#35000000" RenderingBias="Quality" />

    <!-- Level 3: Medium elevation - raised surface -->
    <DropShadowEffect x:Key="Elevation.Level3" BlurRadius="6" ShadowDepth="2" Direction="270"
                      Color="#4C000000" RenderingBias="Quality" />

    <!-- Level 4: High elevation - prominent shadow -->
    <DropShadowEffect x:Key="Elevation.Level4" BlurRadius="12" ShadowDepth="4" Direction="270"
                      Color="#66000000" RenderingBias="Quality" />

    <!-- Level 5: Very high elevation - maximum shadow -->
    <DropShadowEffect x:Key="Elevation.Level5" BlurRadius="16" ShadowDepth="6" Direction="270"
                      Color="#7A000000" RenderingBias="Quality" />

    <!-- ============================ Typography ============================ -->

    <!-- Typeface: Segoe UI Variable Text for Windows, falling back to Segoe UI and generic sans-serif -->
    <!-- Scaled up from Android sp sizes for desktop readability at arm's length -->
    <FontFamily x:Key="Typeface">Segoe UI Variable Text, Segoe UI, Selawik, sans-serif</FontFamily>
        <!-- Material Design 3 typography scale - roles with Windows scaling -->
        <!-- Display sizes -->
        <Style x:Key="Type.DisplayLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="56" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="64" />
        </Style>
        <Style x:Key="Type.DisplayMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="45" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="52" />
        </Style>
        <Style x:Key="Type.DisplaySmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="40" />
        </Style>

        <!-- Headline sizes -->
        <Style x:Key="Type.HeadlineLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="40" />
        </Style>
        <Style x:Key="Type.HeadlineMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="36" />
        </Style>
        <Style x:Key="Type.HeadlineSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="28" />
        </Style>

        <!-- Title sizes -->
        <Style x:Key="Type.TitleLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="28" />
        </Style>
        <Style x:Key="Type.TitleMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="Type.TitleSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!-- Body sizes -->
        <Style x:Key="Type.BodyLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style x:Key="Type.BodyMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="Type.BodySmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <!-- Label sizes -->
        <Style x:Key="Type.LabelLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="Type.LabelMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="Type.LabelSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Mono font -->
        <Style x:Key="Type.Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    <!-- ============================ Buttons ============================
         Material buttons are pill-shaped with a state layer on hover/press rather than a
         border change. Four variants cover the desktop's actual vocabulary: filled for the one
         committing action per region, tonal for supporting actions, outlined for file and
         destructive-adjacent operations, text for anything that should stay quiet. -->

    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Shape.Button}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Label"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{StaticResource State.OnSurface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{StaticResource State.OnSurface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.DisabledContainer}" />
                            <!-- TextElement.Foreground rather than ContentPresenter.Foreground:
                                 a ContentPresenter has no Foreground of its own, and without the
                                 attached property the label would keep the template's colour and
                                 stay fully legible on the disabled surface. -->
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledContent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Material.FilledButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnPrimary}" />
    </Style>

    <Style x:Key="Material.TonalButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSecondaryContainer}" />
    </Style>

    <Style x:Key="Material.OutlinedButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Shape.Button}">
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource State.OnSurface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource State.OnSurface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.OutlineVariant}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledContent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Material.TextButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        <Setter Property="MinWidth" Value="64" />
    </Style>

    <Style x:Key="Material.DangerTextButton" TargetType="Button" BasedOn="{StaticResource Material.TextButton}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
    </Style>

    <!-- Extended FAB, matching the "Add item" FAB on the handheld's detail screen. -->
    <Style x:Key="Material.ExtendedFab" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSecondaryContainer}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Effect" Value="{StaticResource Elevation.Level2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Shape.Medium}"
                            Effect="{TemplateBinding Effect}">
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource State.SecondaryContainer.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource State.SecondaryContainer.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledContent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Material.OutlinedButton}" />

    <!-- ============================ Text field ============================
         The outlined field with a floating label, as on the device's dialogs. The label sits in
         the gap of the outline while the field is focused or holds text, and drops back inside
         when empty and idle. The label carries the surface colour so it masks the outline
         behind it instead of the outline being drawn through the text. -->

    <Style x:Key="Material.OutlinedTextField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Outline"
                                Background="{StaticResource Brush.SurfaceContainer}"
                                BorderBrush="{StaticResource Brush.Outline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Shape.ExtraSmall}" />
                        <!--
                          Default state is FLOATED, not resting. The label only drops back into the
                          box when there is genuinely nothing behind it, so the resting state is the
                          exception rather than the rule. Getting this backwards is what leaves the
                          label sitting on top of the value in every field that has content - the
                          two then render as one overlapping smear.
                        -->
                        <TextBlock x:Name="Label"
                                   Margin="9,0,12,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Background="{StaticResource Brush.SurfaceContainer}"
                                   FontFamily="{StaticResource Typeface}"
                                   FontSize="11"
                                   TextElement.Foreground="{StaticResource Brush.OnSurfaceVariant}"
                                   Text="{TemplateBinding Tag}"
                                   TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="12,0,12,7"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Focus tints the outline. Kept separate from the label's position
                             because the two answer different questions: the outline asks "is this
                             being edited right now", the label asks "is there anything to float
                             away from". -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            <Setter TargetName="Outline" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Brush.Primary}" />
                        </Trigger>

                        <!-- The only case where the label rests inside the box: empty, and not
                             being edited. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                <Condition Property="Text" Value="{x:Static sys:String.Empty}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Label" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Label" Property="Margin" Value="12,0,12,0" />
                            <Setter TargetName="Label" Property="FontSize" Value="13" />
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="12,0,12,0" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Brush.OutlineVariant}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledContent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Material.OutlinedTextField}" />
    <!-- ============================ Chips and badges ============================
         The container list shows the tag as a chip and the unit count as an assist chip, which
         is how the handheld renders the same row. Chips are a Border plus a TextBlock rather
         than a control template: nothing here is interactive, so a custom control would be
         machinery for a static label. -->

    <Style x:Key="Material.Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceContainerHigh}" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.ExtraSmall}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="Material.AssistChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SecondaryContainer}" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.ExtraSmall}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Material.Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Full}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Material.WarningBadge" TargetType="Border" BasedOn="{StaticResource Material.Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.Tertiary}" />
    </Style>

    <!-- ============================ Cards ============================ -->

    <Style x:Key="Material.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceContainer}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Medium}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- The container metadata panel: a secondary-container card, matching the device's
         header card on the detail screen. -->
    <Style x:Key="Material.SecondaryCard" TargetType="Border" BasedOn="{StaticResource Material.Card}">
        <Setter Property="Background" Value="{StaticResource Brush.SecondaryContainer}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Material.PrimaryCard" TargetType="Border" BasedOn="{StaticResource Material.Card}">
        <Setter Property="Background" Value="{StaticResource Brush.PrimaryContainer}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ============================ Lists ============================ -->

    <Style x:Key="Material.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- One container row. Selection is a primary-container fill rather than the system
         highlight, which would clash with the palette; hover gets a state layer. -->
    <Style x:Key="Material.ListItemContainer" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource Shape.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="10,8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource State.OnSurface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PrimaryContainer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox" BasedOn="{StaticResource Material.ListBox}" />
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Material.ListItemContainer}" />

    <!-- ============================ Data grid ============================
         A Material table: flat surface, no zebra striping, a header band in surface-variant,
         and a 2dp primary indicator on the selected row. -->
    <Style x:Key="Material.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceContainer}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.OutlineVariant}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.SurfaceContainer}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>

    <Style x:Key="Material.DataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceVariant}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceVariant}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Material.DataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource Material.DataGrid}" />
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Material.DataGridHeader}" />
    <Style TargetType="DataGridCell" BasedOn="{StaticResource Material.DataGridCell}" />
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <DataGridCellsPresenter />
                        </Border>
                        <!-- The selected-state indicator is a full-height edge rather than a row
                             tint, so the row text keeps its contrast at any quantity. -->
                        <Border x:Name="Indicator" HorizontalAlignment="Left" Width="3"
                                Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource State.OnSurface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PrimaryContainer}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.SurfaceContainerHigh}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Chrome ============================ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#668A8F98" CornerRadius="5" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Ripple Effect ============================ -->
<!-- Material Design 3 ripple simulation using transient brush transitions -->
<!-- WPF doesn't have native ripple, so we simulate it with state-based brush changes -->

    <!-- Ripple container for buttons - uses a temporary adorner pattern -->
    <Style x:Key="Button.Ripple" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Button}" />
    </Style>

    <!-- Focus ripple trigger - simulates MD3 ripple on press -->
    <Style x:Key="Button.RippleTrigger" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Shape.Button}">
                        <!--
                            Border takes a single child, so the label and the ripple overlay are
                            siblings inside a Grid. The ripple paints on top of the label and
                            stretches from the press point outward, which is what makes it read as
                            a state layer rather than a second control.
                        -->
                        <Grid>
                            <ContentPresenter x:Name="Label"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <!-- Ripple effect placeholder - in a full implementation,
                                 this would use a visual state manager or custom adorner -->
                            <Border x:Name="Ripple"
                                    Style="{StaticResource Button.Ripple}"
                                    Margin="-8,-8,0,0"
                                    Padding="8,8"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard Storyboard.TargetName="Ripple">
                                    <DoubleAnimation From="0.5" To="0.1" Duration="0:0:0.3"
                                                     Storyboard.TargetProperty="Opacity" />
                                    <DoubleAnimation From="0" To="100" Duration="0:0:0"
                                                     Storyboard.TargetProperty="Width" />
                                    <DoubleAnimation From="0" To="100" Duration="0:0:0"
                                                     Storyboard.TargetProperty="Height" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation To="0" Duration="0:0:0.2"
                                                     Storyboard.TargetProperty="Opacity"
                                                     Storyboard.TargetName="Ripple" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Progress Indicators ============================ -->

    <!-- Circular progress indicator (determinate and indeterminate) -->
    <Style x:Key="CircularProgress" TargetType="ProgressBar">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="IsIndeterminate" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Shape.Small}"
                            Background="{TemplateBinding Background}">
                        <!--
                             ProgressBar has no ValueContent element: the ring is drawn
                             directly as the template's content, because this template
                             replaces the whole bar rather than decorating the stock one.
                        -->
                        <Canvas Width="48" Height="48">
                            <Path x:Name="PART_Track"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M7,21 c5.523,0,10,-4.477,10,-10
                                          c0,-5.523,-4.477,-10,-10,-10
                                          c-5.523,0,-10,4.477,-10,10
                                          c0,5.523,4.477,10,10,10 Z" />
                            <Ellipse x:Name="PART_Indicator"
                                     Width="20" Height="20"
                                     Fill="{TemplateBinding Foreground}"
                                     Canvas.Left="14" Canvas.Top="14">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                                 Storyboard.TargetProperty="(Canvas.Left)"
                                                                 From="14" To="34" Duration="0:0:1.5"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Canvas>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear progress indicator -->
    <Style x:Key="LinearProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceVariant}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Indeterminate">
                                    <Storyboard>
                                        <DoubleAnimation From="0" To="1" Duration="0:0:2"
                                                         Storyboard.TargetProperty="Width"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="PART_Grid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PART_Track"
                                    Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    Height="{TemplateBinding Height}" />
                            <Border x:Name="PART_Indicator"
                                    Grid.Column="0"
                                    Background="{TemplateBinding Foreground}"
                                    Height="{TemplateBinding Height}"
                                    Width="0" />
                            <Border x:Name="PART_Overflow"
                                    Grid.Column="1"
                                    Background="{TemplateBinding Foreground}"
                                    Height="{TemplateBinding Height}"
                                    Width="Auto" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Dialog Patterns ============================ -->

    <!-- Material dialog background -->
    <Style x:Key="Material.DialogHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Large}" />
    </Style>

    <!-- Dialog title style -->
    <Style x:Key="Material.DialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="24,24,24,12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
    </Style>

    <!-- Dialog content style -->
    <Style x:Key="Material.DialogContent" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="24,0,24,24" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnSurface}" />
    </Style>

    <!-- ============================ Separator ============================ -->

    <!-- Divider for lists and sections -->
    <Style x:Key="Material.Divider" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.OutlineVariant}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ============================ Tooltips (enhanced) ============================ -->

    <!-- Tooltips get the inverse surface so they stay legible over the pale chrome without
         needing a border. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.InverseOnSurface}" />
        <Setter Property="FontFamily" Value="{StaticResource Typeface}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="MaxWidth" Value="250" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Brush.InverseSurface}"
                            CornerRadius="{StaticResource Shape.Small}"
                            Padding="8,4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


