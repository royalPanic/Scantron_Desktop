<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Scantron.Core\Scantron.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- The round-trip test reads a real export as its input, so the fixture has to be
            present at run time and not just in the source tree. -->
      <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

  </Project>
